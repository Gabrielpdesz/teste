# Copie para .env e revise. Nunca versione credenciais.
PORT=3001
PAYMENTS_MODE=demo
DATABASE_PATH=.local/wedding.sqlite
# Em produção: origem HTTPS exata, sem barra final.
PUBLIC_URL=http://localhost:3001
# Gere com npm run admin:setup; não use senha padrão.
# ADMIN_PASSWORD_HASH=
