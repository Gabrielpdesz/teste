{
  "name": "maria-clara-e-gabriel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build && node scripts/build-preview.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "prepare:hosting": "node scripts/prepare-hosting.mjs",
    "publish:preview": "node scripts/publish-preview.mjs",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "admin:setup": "node server/setup-admin.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
